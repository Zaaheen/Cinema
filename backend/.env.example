SPRING_PROFILES_ACTIVE=local
# Copy the JDBC Session pooler values from Supabase Dashboard > Connect.
# Use only an owner-approved clean database; the existing Cinema project has incompatible V4-V7 history.
SPRING_DATASOURCE_URL=jdbc:postgresql://<SESSION_POOLER_HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<SESSION_POOLER_USERNAME>
SPRING_DATASOURCE_PASSWORD=<PRIVATE_DATABASE_PASSWORD>
JWT_SECRET=<PRIVATE_JWT_SECRET_AT_LEAST_32_BYTES>
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8081
